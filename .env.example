# Echo Support AI — Environment Variables

# Admin auth secret (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-secret

# Default admin credentials (used by seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# AI provider (optional — uses built-in mock responder when unset)
# Set to an OpenAI-compatible endpoint to use a real LLM
# AI_PROVIDER_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
